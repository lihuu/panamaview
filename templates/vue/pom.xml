<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>myapp</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>myapp</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <main.class>com.example.Main</main.class>
    <panamaview.version>0.3.0</panamaview.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.lihuu</groupId>
      <artifactId>panamaview</artifactId>
      <version>${panamaview.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!--
        Two JVM flags, both compulsory, neither optional.

        The first keeps AppKit happy: it requires the event loop to own the process' first
        thread, and the java launcher hands main() a freshly created one. Without it the window
        misbehaves in ways that never name the cause. A GraalVM native executable does not need
        it, because its main thread already is the first thread.

        The second grants native access, since the calls into Cocoa and WebKit are native.

        Run the frontend build before this one: scripts/build-frontend.sh writes
        src/main/resources/web/, which is where the page comes from.

        (No double dashes anywhere in these comments: XML forbids them, and Maven fails the whole
        build with a parse error rather than ignoring it.)
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <!-- There was a ${panamaview.jvmArgs} argument here, to let
                 `mvn exec:exec -Dpanamaview.check=true` reach the JVM the way JAVA_OPTS does for
                 ./run.sh. It broke the plain command instead: an unset property does NOT disappear;
                 it is passed through as an *empty* argument, and java takes the empty string for the
                 main class. Measured: the argument list came out with an empty element between
                 the native-access flag and -cp, and the build died with "Could not find or load
                 main class", on macOS and Windows
                 alike. No verification script used this path, which is why nothing caught it.
                 ./run.sh is how a non-default JVM flag is passed; this plugin runs the default. -->
            <argument>-cp</argument>
            <classpath/>
            <argument>${main.class}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <!--
    -XstartOnFirstThread is macOS's alone, and it has to be added by a profile because there is no
    "harmless elsewhere" spelling of it. The JVM treats an unknown -X option as a fatal start-up
    error — measured on Windows 11 with JDK 25: "Unrecognized option: -XstartOnFirstThread",
    "Could not create the Java Virtual Machine" — so a pom carrying it on Windows or Linux does not
    warn, it does not run.

    Not a property either, which is what this replaced. A property set to empty reads as "no flag",
    but exec-maven-plugin passes an empty <argument/> through as an *empty argument*: the command
    line came out with a bare comma in it, and java then took the empty string for the main class —
    "Could not find or load main class". A subtler failure than the one being fixed, and it was
    measured rather than reasoned about.

    A profile is the only tool Maven has for adding one argument to a list under a condition, so
    that is what adds it. Everything else stays put.
  -->
  <profiles>
    <profile>
      <id>macos-first-thread</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <arguments>
                <argument>-XstartOnFirstThread</argument>
                <argument>--enable-native-access=ALL-UNNAMED</argument>
                <argument>-cp</argument>
                <classpath/>
                <argument>${main.class}</argument>
              </arguments>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

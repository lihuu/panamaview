# Build output
target/

# WebView2Loader.dll, downloaded by fetch-loader.ps1 on Windows. Fetched once and verified
# against a sha256 rather than committed, the same as the Tailwind standalone binary: a binary in
# the repository is one nobody can review, and Microsoft publishes it somewhere that can be checked.
loader/

# Generated by scripts/build-css.sh, from input.css and the classes actually used in the page.
# Both are derived, and a committed copy of a derived file goes stale without saying so.
src/main/resources/web/tailwind.css
src/main/resources/web/manifest.txt

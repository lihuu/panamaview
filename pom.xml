<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.lihuu</groupId>
  <artifactId>panamaview</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>

  <name>panamaview</name>
  <description>Drive the operating system's web view from Java over the FFM API. No JNI, no JNA,
    no bundled browser engine.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <!--
    Zero runtime dependencies on purpose: the whole point is to talk to
    Cocoa/WebKit through java.lang.foreign and nothing else.
  -->
  <dependencies/>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!--
        No exec plugin, and no entry point: this is a library. It has no main() to run and
        nothing to launch, so declaring one would mean shipping the demo again. The demo
        lives in demo-app/ and is an ordinary consumer, exactly like the templates.
      -->
    </plugins>
  </build>
</project>

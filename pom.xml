<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.lihuu</groupId>
  <artifactId>panamaview-parent</artifactId>
  <version>1.1.0</version>
  <packaging>pom</packaging>

  <name>panamaview build</name>
  <description>The reactor that builds panamaview, its demo and its Windows probe together.</description>

  <!--
    Required by Maven Central, and only by Maven Central: the private repository accepts a pom with
    none of this. They are stated on the parent because the parent is published too — a consumer
    resolving `io.github.lihuu:panamaview` reads this pom first, so every field Central insists on
    has to be here even though this file builds nothing.

    `url` names the repository rather than a site, because there is no site. Central wants a
    resolvable page describing the project, and the README is that page.
  -->
  <url>https://github.com/lihuu/panamaview</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>lihuu</id>
      <name>lihuu</name>
      <url>https://github.com/lihuu</url>
    </developer>
  </developers>

  <scm>
    <!-- developerConnection is the ssh form Central's tooling expects; connection is the anonymous
         read-only one. Both are required, and both point at the same repository. -->
    <connection>scm:git:https://github.com/lihuu/panamaview.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/lihuu/panamaview.git</developerConnection>
    <url>https://github.com/lihuu/panamaview</url>
    <tag>v1.2.0</tag>
  </scm>

  <!--
    One tree, one version, one build. `mvn install` here builds every module below in dependency
    order, and nothing has to be installed by hand first.

    What this replaces: `scaffold/` and `demo-app/` were independent projects sitting beside a pom
    they had no relationship to, each stating the framework's version a second time. That is how a
    release once shipped a tag whose demo pinned a version that had never been published —
    `release.sh` did not know the file existed and the failure landed on CI three jobs away from the
    cause. A module cannot get out of step with the reactor it is built in.

    `scaffold/` has since left this reactor, for a different reason than the demo's: it stopped being
    a Java artifact at all. The scaffolder is `npm/cli.js` now, a Node CLI whose whole content is
    "copy a directory and rename three strings", so there is no pom for it to be a module of, no jar
    for Maven to install, and no native binary for a platform to be chosen for. Its version lives in
    `npm/package.json`, checked against the framework's by `scripts/release.sh`. The Maven coordinate
    `io.github.lihuu:panamaview-scaffold` no longer exists, here or in any repository.

    Why this is named `panamaview-parent` and not `panamaview`: Maven refuses an aggregator whose
    coordinates collide with a module's, and says so plainly — "Project
    'io.github.lihuu:panamaview:0.2.0' is duplicated in the reactor". The framework's coordinates
    cannot move: they are in every generated project's pom, in the Maven repository the npm package
    bundles, and in the scaffolder's library lookup.

    `templates/` is deliberately *not* a module. A template is copied out of this repository and
    built somewhere else, where this pom does not exist. Giving one a `<parent>` would make every
    generated project unbuildable, so they pin the framework version explicitly instead, and
    `scripts/verify-templates.sh` fails when a pin drifts.
  -->
  <modules>
    <module>framework</module>
    <module>demo-app</module>
    <module>windows-probe</module>
  </modules>

  <properties>
    <!-- The version every module is built at, and the version they depend on each other at. Stated
         once: a module that repeats it is a module that can disagree with this one. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Plugin versions live here so a module cannot quietly carry a different one from its
             siblings. Modules name the plugin; this says which plugin. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>

        <!--
          Maven Central's four extras, versioned here and *bound* only in the `central` profile
          below. Versioning and binding are separated on purpose: the versions are facts about the
          build, the binding is a property of one publication target, and the private repository
          wants none of it. A `mvn deploy` from scripts/deploy-private.sh must keep doing exactly
          what it did before — it deploys to Aliyun with `-DaltDeploymentRepository`, and the
          central-publishing plugin would otherwise intercept that same `deploy` phase.

          What Central requires beyond the pom metadata above:
            - a -sources.jar and a -javadoc.jar beside every .jar (content is not inspected, but
              the files must exist)
            - a detached .asc GPG signature for every file, including the poms
            - checksums, which central-publishing-maven-plugin generates itself
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <goals><goal>jar-no-fork</goal></goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.12.0</version>
          <executions>
            <execution>
              <id>attach-javadocs</id>
              <goals><goal>jar</goal></goals>
            </execution>
          </executions>
          <configuration>
            <!-- A doc-comment lint failing a publication is a trade nobody asked for: the
                 javadoc jar's contents are not inspected by Central, and a warning about a
                 missing @param should not be what stops a release. -->
            <doclint>none</doclint>
            <quiet>true</quiet>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
          <configuration>
            <!--
              `gpgArguments`, not a `pinentryMode` element: this plugin has no such parameter, and
              naming one that does not exist is silently ignored. Maven prints "Parameter
              'pinentryMode' is unknown for plugin" as a warning and signs anyway, so a config that
              does nothing looks like a config that works. Checked against the plugin's own
              plugin.xml rather than the documentation.

              loopback is what keeps a headless run from opening a pinentry dialog and hanging until
              it times out. It needs the key to have no passphrase, or one supplied through
              passphraseEnvName. The key this repository documents is generated with %no-protection.
            -->
            <gpgArguments>
              <arg>--pinentry-mode</arg>
              <arg>loopback</arg>
            </gpgArguments>
          </configuration>
          <executions>
            <execution>
              <id>sign-artifacts</id>
              <phase>verify</phase>
              <goals><goal>sign</goal></goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>0.11.0</version>
          <extensions>true</extensions>
          <configuration>
            <publishingServerId>central</publishingServerId>
            <!--
              Only these two of the four modules. Central is permanent and public; demo-app and
              windows-probe are applications this repository's own rule says are never published
              anywhere. The plugin bundles *every* module of the reactor by default, jar or not,
              with no notion of "this one is an app" — so the two have to be named.

              The value is an exact artifactId, matched with a plain string compare: a groupId
              prefix, a stray space, or a typo does not fail, it silently publishes the module.
            -->
            <excludeArtifacts>
              <artifact>panamaview-demo</artifact>
              <artifact>panamaview-windows-probe</artifact>
            </excludeArtifacts>
            <autoPublish>false</autoPublish>
            <waitUntil>validated</waitUntil>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!--
    The publication target, as a profile rather than part of the build.

    Nothing below runs unless `-Pcentral` is named. That is what keeps scripts/deploy-private.sh —
    a bare `mvn deploy` against Aliyun — from being intercepted by a plugin that also owns the
    `deploy` phase, and what keeps an ordinary `mvn install` from asking for a GPG passphrase.

    `release.sh` will drive this profile; a private-repository deploy never sees it.
  -->
  <profiles>
    <profile>
      <id>central</id>
      <build>
        <plugins>
          <!-- Bound here, not in pluginManagement: this is the list of plugins that actually run. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
